[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libtyrian_godot.so"
linux.release.x86_64 = "res://bin/libtyrian_godot.so"
windows.debug.x86_64 = "res://bin/tyrian_godot.dll"
windows.release.x86_64 = "res://bin/tyrian_godot.dll"
; Universal library (x86_64 + arm64, lipo): scripts/build-macos.sh. The macOS export
; copies it into <App>.app/Contents/Frameworks/.
macos.debug = "res://bin/libtyrian_godot.dylib"
macos.release = "res://bin/libtyrian_godot.dylib"
